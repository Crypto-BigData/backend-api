NODE_ENV=development
PORT=3000

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Worker
WORKER_PORT=3002
BACKFILL_MONTHS=6
COINDESK_API_KEYS=

# Mock mode: true = dùng Binance public API, false = đọc từ ClickHouse
USE_MOCK=true

# Chatbot (Optional — module degrades gracefully without these)
OPENAI_API_KEY=
OPENAI_BASE_URL= # Dùng để trỏ sang API tương thích OpenAI (vd: Groq, LM Studio)
OPENAI_MODEL=gpt-4o-mini
INTERNAL_API_BASE=
