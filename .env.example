NODE_ENV=development
PORT=3000

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redis — format: redis://:password@host:port (password optional)
REDIS_URL=redis://localhost:6379

# Worker
WORKER_PORT=3002
BACKFILL_MONTHS=6
COINDESK_API_KEYS=

# Mock mode: true = dùng Binance public API, false = đọc từ ClickHouse
USE_MOCK=true
